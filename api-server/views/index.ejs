<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PodShip</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="page">
        <header class="header">
            <h1>PodShip</h1>
            <p>Deploy a frontend from GitHub in seconds.</p>
        </header>

        <form id="deploy-form" class="card">
            <label for="gitURL">GitHub repository URL</label>
            <input id="gitURL" type="url" placeholder="https://github.com/user/repo" autocomplete="off" required>

            <label for="slug">Project name <span class="optional">(optional)</span></label>
            <div class="slug-input">
                <input id="slug" type="text" placeholder="random if empty" autocomplete="off" pattern="[a-z0-9-]*"
                    title="Only lowercase letters, numbers and hyphens">
                <span class="suffix">.localhost:8000</span>
            </div>

            <button id="deploy-btn" type="submit">Deploy</button>
            <span id="error" class="hint error"></span>
        </form>

        <section id="deployment" class="card hidden">
            <div class="deploy-header">
                <div>
                    <span id="status" class="status"></span>
                    <span id="project" class="project"></span>
                </div>
                <a id="visit" class="visit hidden" target="_blank" rel="noreferrer">Visit site ↗</a>
            </div>
            <div id="logs" class="logs"></div>
        </section>
    </main>

    <script>window.SOCKET_URL = '<%= socketUrl %>'</script>
    <script src="<%= socketUrl %>/socket.io/socket.io.js"></script>
    <script src="/app.js"></script>
</body>
</html>
